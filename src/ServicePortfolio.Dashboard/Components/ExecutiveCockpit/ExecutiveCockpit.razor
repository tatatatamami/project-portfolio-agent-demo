@using ServicePortfolio.Dashboard.Models

<div class="cockpit-panel">
    @if (_summary is null)
    {
        <div class="loading">
            <p>ダッシュボードデータを読み込んでいます...</p>
        </div>
    }
    else if (_summary.HasError)
    {
        <div class="empty-state empty-state--error">
            <h2>分析結果がありません</h2>
            <p>@_summary.ErrorMessage</p>
        </div>
    }
    else if (!_summary.HasAnalysisResults)
    {
        <div class="empty-state">
            <h2>分析結果がありません</h2>
            <p>Portfolio Analysis Workload の生成結果に候補データが含まれていません。</p>
        </div>
    }
    else
    {
        <section class="section-kpi">
            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-label">分析対象案件</span>
                    <span class="kpi-value">@_summary.TotalProjects<span class="kpi-unit">件</span></span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">事業化候補</span>
                    <span class="kpi-value">@_summary.ServiceCandidateCount<span class="kpi-unit">件</span></span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">受注実績売上</span>
                    <span class="kpi-value">@((_summary.TotalContractedSales / 100_000_000m).ToString("F1"))<span class="kpi-unit">億円</span></span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">受注案件 平均利益率</span>
                    <span class="kpi-value">@(_summary.AverageProfitMargin.ToString("F1"))<span class="kpi-unit">%</span></span>
                </div>
                <div class="kpi-card kpi-card--meta">
                    <span class="kpi-label">最終分析日時</span>
                    <span class="kpi-value kpi-value--small">@FormatGeneratedAt(_summary.GeneratedAt)</span>
                </div>
                <div class="kpi-card kpi-card--meta">
                    <span class="kpi-label">利用モデル</span>
                    <span class="kpi-value kpi-value--small">@FormatModel(_summary)</span>
                </div>
                <div class="kpi-card kpi-card--meta">
                    <span class="kpi-label">分析ステータス</span>
                    <span class="kpi-value kpi-value--small">@_summary.AnalysisStatus</span>
                </div>
            </div>
        </section>

        <section class="section-candidates">
            <h2 class="section-title">案件実績から抽出した事業化候補</h2>
            <ol class="candidate-list">
                @foreach (var candidate in _summary.ServiceCandidates)
                {
                    <li class="candidate-item @(_selectedCandidate == candidate ? "candidate-item--selected" : "")"
                        @onclick="() => SelectCandidate(candidate)">
                        <span class="candidate-rank">@candidate.Rank</span>
                        <div class="candidate-body">
                            <span class="candidate-name">@candidate.Name</span>
                            <span class="candidate-sub-metrics">根拠案件 @(candidate.Metrics.SupportingProjectCount)件 ｜ 受注率 @(candidate.Metrics.WinRate.ToString("F0"))% ｜ 利益率 @(candidate.Metrics.AverageMarginRate.ToString("F1"))%</span>
                            <span class="candidate-biz-model">▶ @candidate.RecommendedBusinessModelLabel</span>
                        </div>
                        <span class="candidate-priority-badge">優先度 @(candidate.Priority.ToString("F0"))</span>
                    </li>
                }
            </ol>
        </section>

        @if (_selectedCandidate is not null)
        {
            <section class="section-detail">
                <div class="detail-header">
                    <h2 class="section-title">
                        @if (_selectedCandidate.Rank == 1)
                        {
                            <span class="badge-top">最優先</span>
                        }
                        @_selectedCandidate.Name
                    </h2>
                </div>

                <div class="detail-rationale">
                    <h3 class="detail-label">なぜ事業化候補なのか</h3>
                    <p class="rationale-text">@_selectedCandidate.BusinessReason</p>
                    <p class="ai-generated-note">AI生成: @_selectedCandidate.ExecutiveSummary</p>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">事業性評価</h3>
                    <div class="priority-metrics-grid">
                        <div class="priority-metric-card priority-metric-card--highlight">
                            <span class="pm-label">事業化優先度</span>
                            <span class="pm-value">@(_selectedCandidate.Priority.ToString("F0"))<span class="pm-unit">/ 100</span></span>
                        </div>
                        <div class="priority-metric-card">
                            <span class="pm-label">根拠案件</span>
                            <span class="pm-value">@(_selectedCandidate.Metrics.SupportingProjectCount)<span class="pm-unit">件・@(_selectedCandidate.Metrics.IndustryCount)業種</span></span>
                        </div>
                        <div class="priority-metric-card">
                            <span class="pm-label">信頼度</span>
                            <span class="pm-value">@(_selectedCandidate.Scores.Confidence)<span class="pm-unit">/ 100</span></span>
                        </div>
                    </div>
                    <div class="sub-metrics-row">
                        <span>受注率 @(_selectedCandidate.Metrics.WinRate.ToString("F1"))%</span>
                        <span>平均利益率 @(_selectedCandidate.Metrics.AverageMarginRate.ToString("F1"))%</span>
                        <span>工数削減率 @(_selectedCandidate.Metrics.AverageEffortReductionRate.ToString("F1"))%</span>
                        <span>受注売上 @((_selectedCandidate.Metrics.WonRevenue / 100_000_000m).ToString("F1"))億円</span>
                    </div>
                    <div class="score-grid">
                        @foreach (var score in GetScoreItems(_selectedCandidate))
                        {
                            <div class="score-item">
                                <span class="score-label">@score.Label</span>
                                <span class="score-value">@score.Value</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">根拠となる案件</h3>
                    <div class="evidence-list">
                        @foreach (var project in _selectedCandidate.SupportingProjects)
                        {
                            <article class="evidence-card">
                                <strong>@project.ProjectId: @project.ProjectName</strong>
                                <span>@project.Industry</span>
                                <p>@project.EvidenceSummary</p>
                            </article>
                        }
                    </div>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">再利用可能な資産</h3>
                    <div class="asset-list">
                        @foreach (var asset in _selectedCandidate.ReusableAssets)
                        {
                            <article class="asset-card">
                                <div>
                                    <strong>@asset.Name</strong>
                                    <span>@asset.Type / @asset.OccurrenceCount of @asset.TotalProjectCount</span>
                                </div>
                                <span class="readiness-score">@asset.ReadinessScore</span>
                                <p>@asset.CurrentState</p>
                                <p class="next-action">次: @asset.NextAction</p>
                            </article>
                        }
                    </div>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">標準化・SaaS化ギャップ</h3>
                    <div class="gap-list">
                        @foreach (var gap in _selectedCandidate.StandardizationGaps)
                        {
                            <article class="gap-card">
                                <strong>@gap.Category</strong>
                                <p>現在: @gap.CurrentState</p>
                                <p>目標: @gap.TargetState</p>
                                <span>優先度 @gap.Priority / 工数 @gap.Effort</span>
                                <span>依存: @gap.Dependency</span>
                            </article>
                        }
                    </div>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">主要リスク</h3>
                    <ul class="risk-list">
                        @foreach (var risk in _selectedCandidate.Risks)
                        {
                            <li class="risk-item">
                                <strong>@risk.Name</strong>
                                <span>影響: @risk.Impact / 発生可能性: @risk.Likelihood</span>
                                <p>@risk.Mitigation</p>
                            </li>
                        }
                    </ul>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">推奨事業モデル</h3>
                    <div class="business-model-box">
                        <span>@_selectedCandidate.RecommendedBusinessModel.Current</span>
                        <span>→</span>
                        <span>@_selectedCandidate.RecommendedBusinessModel.Next</span>
                        <span>→</span>
                        <span>@_selectedCandidate.RecommendedBusinessModel.FutureOption</span>
                    </div>
                    <p class="rationale-text">@_selectedCandidate.RecommendedBusinessModel.Rationale</p>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">次に必要な経営判断</h3>
                    <p class="decision-text">@_selectedCandidate.ManagementDecision.Decision</p>
                    <div class="decision-meta">
                        <span>投資規模: @_selectedCandidate.ManagementDecision.InvestmentLevel</span>
                        <span>時間軸: @_selectedCandidate.ManagementDecision.TimeHorizon</span>
                    </div>
                    <div class="decision-lists">
                        <div>
                            <h4>90日以内の推奨アクション</h4>
                            <ul>
                                @foreach (var action in _selectedCandidate.ManagementDecision.Next90Days)
                                {
                                    <li>@action</li>
                                }
                            </ul>
                        </div>
                        <div>
                            <h4>成功条件</h4>
                            <ul>
                                @foreach (var criterion in _selectedCandidate.ManagementDecision.SuccessCriteria)
                                {
                                    <li>@criterion</li>
                                }
                            </ul>
                        </div>
                        <div>
                            <h4>中止・見直し条件</h4>
                            <ul>
                                @foreach (var criterion in _selectedCandidate.ManagementDecision.StopOrReviewCriteria)
                                {
                                    <li>@criterion</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="detail-section">
                    <h3 class="detail-label">成功・失敗要因</h3>
                    <div class="factor-columns">
                        <div>
                            <h4>成功要因</h4>
                            <ul>
                                @foreach (var factor in _selectedCandidate.SuccessFactors)
                                {
                                    <li>@factor</li>
                                }
                            </ul>
                        </div>
                        <div>
                            <h4>失敗・遅延要因</h4>
                            <ul>
                                @foreach (var factor in _selectedCandidate.FailureFactors)
                                {
                                    <li>@factor</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public EventCallback<ServiceCandidate> OnAskAIClicked { get; set; }

    [Inject] private IDashboardDataService DashboardDataService { get; set; } = default!;

    private DashboardSummary? _summary;
    private ServiceCandidate? _selectedCandidate;

    protected override async Task OnInitializedAsync()
    {
        _summary = await DashboardDataService.GetDashboardSummaryAsync();
        _selectedCandidate = _summary.ServiceCandidates.FirstOrDefault();
    }

    private void SelectCandidate(ServiceCandidate candidate)
    {
        _selectedCandidate = candidate;
    }

    private static string FormatGeneratedAt(DateTimeOffset? generatedAt) =>
        generatedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "未生成";

    private static string FormatModel(DashboardSummary summary) =>
        string.IsNullOrWhiteSpace(summary.ModelDeployment)
            ? summary.ModelProvider
            : $"{summary.ModelProvider} / {summary.ModelDeployment}";

    private static IReadOnlyList<(string Label, int Value)> GetScoreItems(ServiceCandidate candidate) =>
    [
        ("収益性", candidate.Scores.Profitability),
        ("再利用性", candidate.Scores.Reusability),
        ("標準化", candidate.Scores.Standardization),
        ("継続収益", candidate.Scores.RecurringRevenue),
        ("SaaS適合", candidate.Scores.SaasReadiness),
        ("実現性", candidate.Scores.Feasibility),
        ("信頼度", candidate.Scores.Confidence)
    ];
}
