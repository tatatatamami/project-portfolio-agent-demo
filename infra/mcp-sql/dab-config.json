{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.9/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('MSSQL_CONNECTION_STRING')",
    "options": {
      "set-session-context": false
    }
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api",
      "request-body-strict": false
    },
    "graphql": {
      "enabled": false,
      "path": "/graphql",
      "allow-introspection": true
    },
    "mcp": {
      "enabled": true,
      "path": "/mcp"
    },
    "host": {
      "cors": {
        "origins": [],
        "allow-credentials": false
      },
      "authentication": {
        "provider": "Unauthenticated"
      },
      "mode": "production"
    },
    "telemetry": {
      "open-telemetry": {
        "enabled": true,
        "endpoint": "@env('OTEL_EXPORTER_OTLP_ENDPOINT')",
        "headers": "@env('OTEL_EXPORTER_OTLP_HEADERS')",
        "service-name": "@env('OTEL_SERVICE_NAME')"
      }
    }
  },
  "autoentities": {},
  "entities": {
    "TopCandidates": {
      "description": "Ranked service assetization candidates with ICE score, win rate, revenue, supporting project count, and business model recommendation.",
      "source": {
        "object": "dbo.vTopCandidates",
        "type": "view",
        "key-fields": [
          "CandidateID"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "TopCandidates",
          "plural": "TopCandidates"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "CandidateIceBreakdown": {
      "description": "ICE axis scores and contributing factors for each service assetization candidate.",
      "source": {
        "object": "dbo.vCandidateIceBreakdown",
        "type": "view",
        "key-fields": [
          "CandidateID",
          "AxisName",
          "FactorOrder"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "CandidateIceBreakdown",
          "plural": "CandidateIceBreakdowns"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "CandidateEvidenceProjects": {
      "description": "Evidence projects and source IDs supporting each service assetization candidate.",
      "source": {
        "object": "dbo.vCandidateEvidenceProjects",
        "type": "view",
        "key-fields": [
          "CandidateID",
          "ProjectID"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "CandidateEvidenceProjects",
          "plural": "CandidateEvidenceProjects"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "CandidateSaasGaps": {
      "description": "Standardization and SaaS readiness gaps for each candidate.",
      "source": {
        "object": "dbo.vCandidateSaasGaps",
        "type": "view",
        "key-fields": [
          "CandidateID",
          "GapOrder"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "CandidateSaasGaps",
          "plural": "CandidateSaasGaps"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    },
    "Candidate90DayDecisions": {
      "description": "Management decision, investment horizon, next 90 day actions, success criteria, and review criteria for each candidate.",
      "source": {
        "object": "dbo.vCandidate90DayDecisions",
        "type": "view",
        "key-fields": [
          "CandidateID",
          "ItemType",
          "ItemOrder"
        ]
      },
      "graphql": {
        "enabled": true,
        "type": {
          "singular": "Candidate90DayDecisions",
          "plural": "Candidate90DayDecisions"
        }
      },
      "rest": {
        "enabled": true
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            {
              "action": "read"
            }
          ]
        }
      ]
    }
  }
}